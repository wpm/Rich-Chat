{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rich Chat",
  "version": "0.1.0",
  "identifier": "io.github.wpm.rich-chat",
  "build": {
    "beforeDevCommand": { "script": "trunk serve", "cwd": ".." },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": ".." },
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rich Chat",
        "width": 900,
        "height": 700,
        "minWidth": 400,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
